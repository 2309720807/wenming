; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wenming"
run/main_scene="res://scenes/ui/login.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/data/game_state.gd"
TimeManager="*res://scripts/data/time_manager.gd"
BuildingSystem="*res://scripts/game/building_system.gd"
WindowManager="*res://scripts/data/window_manager.gd"
GiftCodeManager="*res://scripts/data/gift_code_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
MilitarySystem="*res://scripts/data/military_system.gd"
SaveManager="*res://scripts/data/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://assets/fonts/default_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
